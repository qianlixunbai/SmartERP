# ============================================
# SmartERP — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
#
# WARNING: .env is git-ignored — NEVER commit real secrets!
# WARNING: Spring Boot does NOT auto-load .env files.
#          Use one of the documented startup methods instead.
# ============================================

# --- Database ---
SMARTERP_DB_URL=jdbc:mysql://localhost:3306/smarterp
SMARTERP_DB_USERNAME=root
SMARTERP_DB_PASSWORD=replace-with-your-local-password

# --- JWT ---
# Requirements: at least 32 characters, strong random value.
# Generate: $bytes = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Fill($bytes); [Convert]::ToBase64String($bytes)
SMARTERP_JWT_SECRET=replace-with-at-least-32-characters
SMARTERP_JWT_EXPIRATION=86400000

# --- Spring Profile ---
# dev  = local development (default)
# prod = production (all credentials must come from real env vars)
SPRING_PROFILES_ACTIVE=dev

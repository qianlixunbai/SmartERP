# ============================================
# SmartERP — Environment Variables Template
# ============================================
# Copy this file to .env and fill in your actual values.
#   cp .env.example .env
#
# WARNING: .env is git-ignored — NEVER commit real secrets!
# ============================================

# --- Database ---
SMARTERP_DB_URL=jdbc:mysql://localhost:3306/smarterp?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8
SMARTERP_DB_USERNAME=root
SMARTERP_DB_PASSWORD=your_password_here

# --- JWT ---
# Generate a strong secret (at least 256 bits / 32 ASCII characters).
# Example for Linux/macOS:   openssl rand -base64 32
# Example for PowerShell:    [Convert]::ToBase64String((1..32 | ForEach { Get-Random -Max 256 }))
SMARTERP_JWT_SECRET=your-256-bit-secret-key-min-32-chars
SMARTERP_JWT_EXPIRATION=86400000

# --- Spring Profile ---
# dev  = local development (default)
# prod = production (all credentials from env vars)
SPRING_PROFILES_ACTIVE=dev
